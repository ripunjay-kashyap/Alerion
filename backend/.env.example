# ---------- Database ----------
# Supabase → Project Settings → Database → Connection string → "Session pooler" (port 5432).
# Use the POOLER host (aws-0-<region>.pooler.supabase.com), NOT db.<ref>.supabase.co — the direct
# host is IPv6-only and Render can't reach it. Swap the scheme to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local dev without Supabase:
# DATABASE_URL=sqlite+aiosqlite:///./alerion.db

# ---------- Mapbox ----------
# Public token (pk.*) WITHOUT URL restrictions (server calls send no browser origin).
# Keep it separate from the URL-restricted frontend token. Used for Directions + Geocoding.
MAPBOX_TOKEN=pk.xxxxx
# live | cache_first | cache_only   (cache_first for demo; cache_only for offline tests)
MAPBOX_MODE=cache_first

# ---------- SerpApi ----------
# https://serpapi.com/manage-api-key — Google Maps (landmark locations, nearby hospitals),
# Google News + Google Search (corroboration, flood scan). Never exposed to the browser.
SERPAPI_KEY=
# live | cache_first | cache_only   (cache_first for demo: cached answers cost no quota)
SERPAPI_MODE=cache_first

# ---------- HTTP ----------
# Comma-separated. *.vercel.app previews are allowed automatically.
CORS_ORIGINS=http://localhost:3000
